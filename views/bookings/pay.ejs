<% layout('/layouts/boilerplate.ejs') %>
<div class="row mt-3">
  <div class="col-md-8 offset-md-2">
    <h3>Complete payment for your booking</h3>
    <p>Listing: <strong><%= booking.listing.title %></strong></p>
    <p>Amount to pay: <strong>₹<%= booking.totalPrice ? booking.totalPrice.toLocaleString('en-IN') : '0' %></strong></p>
    <p>Booking dates: <%= booking.startDate.toDateString() %> — <%= booking.endDate.toDateString() %></p>

    <% if (qrDataUrl) { %>
      <div class="text-center mb-3">
        <p>Scan this QR with your banking app or UPI app to pay:</p>
        <img src="<%= qrDataUrl %>" alt="Payment QR code" style="max-width:300px;" />
      </div>
      <p class="small text-muted">This QR encodes a payment link. In production replace this with a real payment gateway QR or checkout session (Stripe/Razorpay/Paytm).</p>
    <% } else { %>
      <p>QR code generation failed. Use this link to complete payment:</p>
      <a href="<%= paymentLink %>"><%= paymentLink %></a>
    <% } %>

    <div class="mt-3">
      <a href="/listings/<%= booking.listing._id %>" class="btn btn-outline-dark">Back to listing</a>
    </div>
  </div>
</div>
